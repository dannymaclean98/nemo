# Environment Configuration
# 'development' = Base Sepolia testnet (default)
# 'production' = Base mainnet
NEXT_PUBLIC_ENVIRONMENT=development

# Contract Addresses for Different Networks
# Base Mainnet contract address (production)
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE=0x995AaB266d4Ce959AdC380f8D39608acbcf0b578
# Base Sepolia contract address (development/testing)  
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE_SEPOLIA=0x2C64555E4F0Ba96fb193efCb3797ebF56123ab2F

# WalletConnect Project ID (required for RainbowKit)
# Get your project ID from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Contract Deployment (for development)
# Your wallet private key for deploying contracts (NEVER commit this to git!)
PRIVATE_KEY=your_private_key_here

# BaseScan API key for contract verification (optional)
# Get your API key from https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key_here

# IPFS Storage (Pinata) - Required for NFT metadata and image storage
# Get your JWT token from https://pinata.cloud/account/api-keys
PINATA_JWT=your_pinata_jwt_token_here
NEXT_PUBLIC_GATEWAY_URL=https://gateway.pinata.cloud